{
  "name": "local-doc-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.build.cjs",
  "description": "로컬 웹 뷰어 - .docx / .xlsx 파일을 업로드 없이 브라우저에서 열람 (폐쇄망 대응, CDN 미사용)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "cross-env SINGLE=1 vite build",
    "preview": "vite preview",
    "build:main": "esbuild electron/main.cjs --bundle --platform=node --format=cjs --external:electron --outfile=electron/main.build.cjs",
    "electron:dev": "npm run build:main && electron .",
    "dist:win": "npm run build && npm run build:main && electron-builder --win zip"
  },
  "dependencies": {
    "docx-preview": "0.3.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "cross-env": "^7.0.3",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.21.5",
    "html-to-docx": "^1.8.0",
    "mammoth": "^1.8.0",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "build": {
    "appId": "com.local.docviewer",
    "productName": "문서뷰어",
    "directories": {
      "output": "release-exe",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/main.build.cjs",
      "electron/preload.cjs"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "문서뷰어-win.${ext}"
    }
  }
}
